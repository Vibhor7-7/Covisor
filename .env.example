# Copy to .env and fill in. Never commit .env.
PORT=3001
MOCK=1
CODEVISOR_URL=http://127.0.0.1:49361
CODEVISOR_TOKEN=            # from `codevisor token`
LINEAR_API_KEY=
LINEAR_TEAM_KEY=            # optional, e.g. CHK
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
MANAGER_MODEL=opus
DEMO_REPO=/Users/sharvibhor/Desktop/Projects/covisor-demo
MEETING_SOURCE=file        # auto | granola | file  (use file for the demo story)
GRANOLA_API_KEY=           # optional, Granola Business plan
ELEVENLABS_MODEL_ID=       # optional, defaults to eleven_flash_v2_5

# Manager run (all optional)
CLAUDE_BIN=                # path to claude, defaults to `claude` on PATH
MANAGER_LINEAR_MCP=        # 0 disables Linear MCP even when LINEAR_API_KEY is set
MANAGER_EFFORT=
MANAGER_MAX_BUDGET_USD=
MANAGER_TIMEOUT_MS=        # default 600000 (10 min) to wait for plan.json
MANAGER_DISPATCH=          # off = write the plan but launch no Codevisor sessions (for testing)
MANAGER_KEEP_API_KEY=      # 1 = pass ANTHROPIC_API_KEY through to claude (stripped by default)

# Codevisor dispatch (all optional)
CODEVISOR_LAUNCH=          # agents (default, POST /v1/agents) | sessions (fallback path)
CODEVISOR_MODEL_OPUS=      # default claude-opus-5-5
CODEVISOR_MODEL_SONNET=    # default claude-sonnet-5-5
CODEVISOR_MODEL_LOCAL=     # default claude-sonnet-5-5 (no local harness ready)
